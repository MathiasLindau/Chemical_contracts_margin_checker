OPENAI_API_KEY=your_api_key

POSTGRES_DB=contracts_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=app_postgres

# Used by local Streamlit / evaluation scripts against the published Postgres port.
# Docker Compose overrides this inside the app container to use host `app_postgres`.
DB_CONN=postgresql://postgres:password@localhost:5432/contracts_db

# Extra OpenAI call after each answer: "Is this answer relevant?"
# On by default (1). Set to 0 to skip the judge and save time/cost.
RAG_LLM_JUDGE=1

# History and Grafana timestamps. Postgres stores UTC; the UI converts.
TZ=Europe/Berlin
DISPLAY_TZ=Europe/Berlin

# Grafana login at http://localhost:3000 (dashboard is provisioned from grafana/).
GRAFANA_ADMIN_PASSWORD=admin
